{
	"name": "verimaya",
	"private": true,
	"packageManager": "pnpm@11.1.3",
	"scripts": {
		"dev": "turbo run dev --filter=@verimaya/web",
		"dev:api": "turbo run dev --filter=@verimaya/api",
		"dev:all": "turbo run dev --filter=@verimaya/web --filter=@verimaya/api",
		"build": "turbo run build",
		"lint": "turbo run lint",
		"check": "turbo run check",
		"format": "turbo run format",
		"format:check": "pnpm --filter @verimaya/web exec prettier --check .",
		"db:up": "docker compose up -d",
		"db:down": "docker compose down",
		"db:migrate": "pnpm --filter @verimaya/api db:migrate",
		"test": "turbo run test --filter=@verimaya/api --filter=@verimaya/shared --filter=@verimaya/web"
	},
	"devDependencies": {
		"turbo": "^2.10.8"
	}
}

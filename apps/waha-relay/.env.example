# Verimaya webhook uç noktası (tam URL).
VERIMAYA_WEBHOOK_URL=https://api.verimaya.com/v1/webhooks/waha

# WAHA'nın bu araca göstereceği sabit token. WAHA tarafında:
#   WHATSAPP_HOOK_CUSTOM_HEADERS='[{"name":"X-Webhook-Token","value":"<aynı-değer>"}]'
# Üret: openssl rand -hex 32
RELAY_INBOUND_TOKEN=

# Hangi WAHA oturumu hangi firmaya ait ve hangi secret'la imzalanacak.
# secret = o firmanın tenant_provider_identities satırındaki secret (DEPLOY-COOLIFY.md § WEBHOOK-01).
RELAY_SESSIONS={"default":{"tenantId":"<tenant-uuid>","secret":"<hex-secret>"}}

# İsteğe bağlı
PORT=8080
RELAY_MAX_BODY_BYTES=2097152
RELAY_TIMEOUT_MS=10000

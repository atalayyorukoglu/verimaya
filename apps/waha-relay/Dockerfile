# Bağımlılığı olmayan tek dosyalık servis — npm install adımı yok, saldırı yüzeyi de yok.
FROM node:22-alpine

WORKDIR /app
COPY package.json ./
COPY src ./src

# Root olarak çalışmaz: bu konteyner internete açık ve firma secret'larını taşıyor.
USER node

ENV PORT=8080
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
	CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||8080)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "src/server.mjs"]

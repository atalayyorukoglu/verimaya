		"@nestjs/cli": "^11.0.10",
		"@nestjs/schematics": "^11.0.7",
		"@types/node": "^24.13.3",
		"drizzle-kit": "^0.31.4",
		"typescript": "^5.9.2",
		"vitest": "^4.1.10",

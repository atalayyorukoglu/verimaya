# Migrate as DB owner (superuser). App runtime uses verimaya_app (RLS enforced).
DATABASE_URL=postgresql://verimaya:verimaya@localhost:5433/verimaya
DATABASE_URL_APP=postgresql://verimaya_app:verimaya@localhost:5433/verimaya
REDIS_URL=redis://localhost:6379
API_PORT=3000
NODE_ENV=development
# Prod: Coolify secret store — ≥32 random chars (docs/DEPLOY-COOLIFY.md).
BETTER_AUTH_SECRET=dev-only-change-me-to-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
# WAHA inbound webhook — HMAC-SHA256 of `${timestamp}.${rawBody}`; header `X-Webhook-Signature: v1=<hex>`
# plus `X-Webhook-Timestamp` (unix seconds, ±5 min). See apps/api/README.md.
WAHA_WEBHOOK_SECRET=dev-waha-webhook-secret
# Generic /v1/webhooks/:provider — same HMAC scheme; env key WEBHOOK_SECRET_<PROVIDER>
# (e.g. ghl → WEBHOOK_SECRET_GHL). Missing secret → 401.
# WEBHOOK_SECRET_GHL=dev-ghl-webhook-secret
# --- GHL Marketplace OAuth (Adım 40) ---
# Redirect base falls back to ADS_OAUTH_REDIRECT_BASE when unset.
GHL_OAUTH_REDIRECT_BASE=
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
# Space-separated scopes (must match Marketplace app). Default: contacts + opportunities.
# GHL_OAUTH_SCOPES=contacts.readonly contacts.write opportunities.readonly opportunities.write
# Location (sub-account) or Company (agency). Default Location.
GHL_USER_TYPE=Location
# Prod zorunlu: 32-byte hex (64 chars) veya base64. Kaybolursa şifreli credential'lar
# okunamaz — yedekle (Coolify secret + offline). Generate: openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=
# --- Ads OAuth (RM-4) ---
# Meta go-live checklist: docs/ADS-META-GOLIVE.md
# API'nin dışarıdan görünen kök URL'i (OAuth redirect_uri üretiminde kullanılır).
ADS_OAUTH_REDIRECT_BASE=http://localhost:3000
# OAuth callback sonrası tarayıcının döneceği web kökü (/settings/connections/ads?ads=...).
# Also added to API CORS allowlist (public karne + OAuth return). Panel uses TRUSTED_ORIGINS.
# Prod: https://verimaya.com (hub) — panel cookie host is app; include both in TRUSTED_ORIGINS.
WEB_PUBLIC_URL=http://localhost:5174
# Comma-separated browser origins for the panel SPA (CORS + better-auth trustedOrigins).
# Local: hub + panel hosts. Prod: https://verimaya.com,https://app.verimaya.com
TRUSTED_ORIGINS=http://localhost:5173,http://app.localhost:5173
# Meta for Developers uygulama kimliği (Facebook Login / Marketing API).
META_APP_ID=
# Meta uygulama secret'ı (token exchange; asla istemciye/log'a sızdırılmaz).
META_APP_SECRET=
# Graph API sürümü (varsayılan v21.0; örn. v21.0).
META_API_VERSION=v21.0
# Google Cloud OAuth 2.0 client ID (adwords scope).
GOOGLE_ADS_CLIENT_ID=
# Google OAuth client secret.
GOOGLE_ADS_CLIENT_SECRET=
# Google Ads API developer token (API çağrı header'ı).
GOOGLE_ADS_DEVELOPER_TOKEN=
# Optional MCC manager customer id (digits); sets login-customer-id on Ads API calls.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Optional: client account to pull metrics from (MCC OAuth often only exposes the manager).
GOOGLE_ADS_CUSTOMER_ID=
# Google Ads API version (default v25). Sunset versions return HTML 404.
GOOGLE_ADS_API_VERSION=v25
# Local patient-file upload stub (default: .data/uploads). S3/R2 later.
UPLOAD_DIR=
# File storage driver: local (default) | s3 (Cloudflare R2 / S3-compatible).
# Mixed keys work: operations route by storage_key scheme (local:// vs s3://).
# New uploads follow STORAGE_DRIVER. Migrate existing: pnpm files:migrate-s3 [-- --apply]
STORAGE_DRIVER=local
# --- S3 / R2 (required when STORAGE_DRIVER=s3; optional alongside local during migration) ---
# Bucket must be private; access only via API proxy stream or short-lived presigned URLs.
# Prefer an EU region for KVKK/GDPR (MIMARI.md). See docs/DEPLOY-COOLIFY.md.
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=verimaya-files
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Path-style URLs (R2: leave unset/true; set false only if your endpoint requires virtual-hosted).
# S3_FORCE_PATH_STYLE=true
# Karne e-posta/lead toplama (POST /v1/public/karne/leads). Varsayılan kapalı (fail-closed).
# Hukuk/KVKK onayı sonrası bilinçli olarak true yapın; web tarafında da
# PUBLIC_KARNE_LEADS_ENABLED=true gerekir.
# KARNE_LEADS_ENABLED=true
# Opsiyonel: Bull Board (/v1/admin/queues) — production'da X-Admin-Queue-Token header ile
# ADMIN_QUEUE_TOKEN=change-me-in-production
# Opsiyonel: per-tenant BullMQ schedulers (ghl.reconcile + ad_metrics.sync 6h;
# files.sweep_pending 24h). Default off — leave unset/false locally so workers
# do not spam Redis. Manual enqueue still works.
# ENABLE_INTEGRATION_SCHEDULERS=true
# files.sweep_pending: count orphans but do not delete (first week in prod)
# FILES_SWEEP_DRY_RUN=true
# Prod: Sentry DSN (Coolify secret). Boşsa no-op; pino + request_id her zaman aktif.
SENTRY_DSN=
# Opsiyonel: OpenAI-uyumlu LLM (boşsa heuristic parse)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Chat completions HTTP timeout (ms); aşımda heuristic'e düşer
LLM_TIMEOUT_MS=15000

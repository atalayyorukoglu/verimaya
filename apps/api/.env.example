# Migrate as DB owner (superuser). App runtime uses verimaya_app (RLS enforced).
DATABASE_URL=postgresql://verimaya:verimaya@localhost:5433/verimaya
DATABASE_URL_APP=postgresql://verimaya_app:verimaya@localhost:5433/verimaya
REDIS_URL=redis://localhost:6379
API_PORT=3000
NODE_ENV=development
BETTER_AUTH_SECRET=dev-only-change-me-to-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
WEBHOOK_STUB_SECRET=dev-webhook-secret
CREDENTIALS_ENCRYPTION_KEY=
# Ads OAuth (RM-4): API public base for callback redirect_uri; web origin after connect.
ADS_OAUTH_REDIRECT_BASE=http://localhost:3000
WEB_PUBLIC_URL=http://localhost:5174
# Meta Marketing API (RM-4b) — empty is fine for build; live OAuth needs real values.
META_APP_ID=
META_APP_SECRET=
# META_API_VERSION=v21.0
# Local patient-file upload stub (default: .data/uploads). S3/R2 later.
UPLOAD_DIR=
# Opsiyonel: Bull Board (/v1/admin/queues) — production'da X-Admin-Queue-Token header ile
# ADMIN_QUEUE_TOKEN=change-me-in-production
# Opsiyonel: per-tenant 6h BullMQ schedulers (ghl.reconcile + ad_metrics.sync). Default off —
# leave unset/false locally so workers do not spam Redis. Manual enqueue still works.
# ENABLE_INTEGRATION_SCHEDULERS=true
# Opsiyonel: Sentry (boşsa no-op; pino + request_id her zaman aktif)
SENTRY_DSN=
# Opsiyonel: OpenAI-uyumlu LLM (boşsa heuristic parse)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Migrate as DB owner (superuser). App runtime uses verimaya_app (RLS enforced).
DATABASE_URL=postgresql://verimaya:verimaya@localhost:5433/verimaya
DATABASE_URL_APP=postgresql://verimaya_app:verimaya@localhost:5433/verimaya
REDIS_URL=redis://localhost:6379
API_PORT=3000
NODE_ENV=development
BETTER_AUTH_SECRET=dev-only-change-me-to-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
WEBHOOK_STUB_SECRET=dev-webhook-secret
# WAHA inbound webhook — HMAC-SHA256 of `${timestamp}.${rawBody}`; header `X-Webhook-Signature: v1=<hex>`
# plus `X-Webhook-Timestamp` (unix seconds, ±5 min). See apps/api/README.md.
WAHA_WEBHOOK_SECRET=dev-waha-webhook-secret
CREDENTIALS_ENCRYPTION_KEY=
# --- Ads OAuth (RM-4) ---
# API'nin dışarıdan görünen kök URL'i (OAuth redirect_uri üretiminde kullanılır).
ADS_OAUTH_REDIRECT_BASE=http://localhost:3000
# OAuth callback sonrası tarayıcının döneceği web kökü (/settings/connections/ads?ads=...).
# Also added to API CORS allowlist (public karne + OAuth return). Panel uses TRUSTED_ORIGINS.
WEB_PUBLIC_URL=http://localhost:5174
# Comma-separated browser origins for the panel SPA (CORS + better-auth trustedOrigins).
TRUSTED_ORIGINS=http://localhost:5173
# Meta for Developers uygulama kimliği (Facebook Login / Marketing API).
META_APP_ID=
# Meta uygulama secret'ı (token exchange; asla istemciye sızdırılmaz).
META_APP_SECRET=
# Graph API sürümü (varsayılan v21.0; örn. v21.0).
META_API_VERSION=v21.0
# Google Cloud OAuth 2.0 client ID (adwords scope).
GOOGLE_ADS_CLIENT_ID=
# Google OAuth client secret.
GOOGLE_ADS_CLIENT_SECRET=
# Google Ads API developer token (API çağrı header'ı).
GOOGLE_ADS_DEVELOPER_TOKEN=
# Local patient-file upload stub (default: .data/uploads). S3/R2 later.
UPLOAD_DIR=
# File storage driver: local (default) | s3 (Cloudflare R2 / S3-compatible).
# Mixed keys work: operations route by storage_key scheme (local:// vs s3://).
# New uploads follow STORAGE_DRIVER. Migrate existing: pnpm files:migrate-s3 [-- --apply]
STORAGE_DRIVER=local
# --- S3 / R2 (required when STORAGE_DRIVER=s3; optional alongside local during migration) ---
# Bucket must be private; access only via API proxy stream or short-lived presigned URLs.
# Prefer an EU region for KVKK/GDPR (MIMARI.md). See docs/DEPLOY-COOLIFY.md.
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=verimaya-files
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Path-style URLs (R2: leave unset/true; set false only if your endpoint requires virtual-hosted).
# S3_FORCE_PATH_STYLE=true
# Opsiyonel: Bull Board (/v1/admin/queues) — production'da X-Admin-Queue-Token header ile
# ADMIN_QUEUE_TOKEN=change-me-in-production
# Opsiyonel: per-tenant 6h BullMQ schedulers (ghl.reconcile + ad_metrics.sync). Default off —
# leave unset/false locally so workers do not spam Redis. Manual enqueue still works.
# ENABLE_INTEGRATION_SCHEDULERS=true
# Opsiyonel: Sentry (boşsa no-op; pino + request_id her zaman aktif)
SENTRY_DSN=
# Opsiyonel: OpenAI-uyumlu LLM (boşsa heuristic parse)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Copy to apps/web/.env for local overrides.

# NestJS API origin (used when PUBLIC_USE_MSW=false)
PUBLIC_API_URL=http://localhost:3000

# Absolute public site origin (canonical, Open Graph, JSON-LD). No trailing slash.
PUBLIC_SITE_URL=https://verimaya.com

# Default: real API. Set to true to enable the MSW demo (mocks /v1/* in dev, no API needed).
PUBLIC_USE_MSW=false

# Free AI scorecard telemetry → POST /v1/public/karne/*.
# Unset: off in dev, on in production. Set true/false to force.
# PUBLIC_KARNE_TELEMETRY=true

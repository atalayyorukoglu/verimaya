# Copy to apps/web/.env for local overrides.

# NestJS API origin. Local host-split: leave empty (Vite proxies /v1 → :3000, same-origin cookies).
# Production build: https://api.verimaya.com
PUBLIC_API_URL=

# Marketing hub (canonical, Open Graph, JSON-LD). No trailing slash.
# Local host split: http://localhost:5173 = hub; http://app.localhost:5173 = panel/login.
# Production: https://verimaya.com
PUBLIC_SITE_URL=http://localhost:5173

# Panel / login host. Hub "App Verimaya" CTA points here.
# Local: http://app.localhost:5173 — Production: https://app.verimaya.com
PUBLIC_APP_URL=http://app.localhost:5173

# GHL white-label CRM. Hub "CRM Verimaya" CTA points here.
PUBLIC_CRM_URL=https://crm.verimaya.com

# Default: real API. Set to true to enable the MSW demo (mocks /v1/* in dev, no API needed).
PUBLIC_USE_MSW=false

# Free AI scorecard telemetry → POST /v1/public/karne/*.
# Unset: off in dev, on in production. Set true/false to force.
# PUBLIC_KARNE_TELEMETRY=true

# Free scorecard email / lead capture. Fail-closed: only explicit true shows the form
# and permits POST /v1/public/karne/leads. Keep false until KVKK/legal approval.
PUBLIC_KARNE_LEADS_ENABLED=false
